PORT=5000
NODE_ENV=development
DATABASE_URL=postgres://user:password@host/db
FRONTEND_ORIGINS=http://localhost:5173

# Microsoft Graph delegated auth (syncs to YOUR OneDrive only).
# 1. Azure Portal -> App registrations -> New registration
#    (any name, no redirect URI needed)
# 2. Authentication tab -> Advanced settings -> turn ON
#    "Allow public client flows"
# 3. Copy the Application (client) ID below.
# 4. Run `npm run ms-login` once and sign in when prompted.
MS_CLIENT_ID=
# Optional. Leave as "common" unless you know you need a specific tenant.
MS_TENANT_ID=common
# Optional. Path inside your OneDrive root. Defaults to CSAT/agents.xlsx
MS_ONEDRIVE_FILE_PATH=CSAT/agents.xlsx
