{
  "name": "automated-email-ticket-rating",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "backend",
    "feedback-website"
  ],
  "scripts": {
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=feedback-website",
    "build:backend": "npm run build --workspace=backend",
    "build:frontend": "npm run build --workspace=feedback-website",
    "build": "npm run build:backend && npm run build:frontend",
    "start": "npm run start --workspace=backend"
  }
}
